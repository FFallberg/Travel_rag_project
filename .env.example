REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=travel-rag/0.1 by your_reddit_username

# Optional for a higher Stack Exchange API quota; small anonymous runs need no key.
STACKEXCHANGE_API_KEY=

# Local generation through Ollama. Override these only when using another model
# or Ollama server.
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
